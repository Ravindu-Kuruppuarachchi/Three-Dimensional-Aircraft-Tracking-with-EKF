# GitHub selection: MATLAB source, published MATLAB results and active report.
# Everything else remains local. Existing tracked files are not untracked by this rule.
/*
!/.gitignore
!/README.md
!/PROJECT_WALKTHROUGH.md

!/matlab/
/matlab/*
!/matlab/*.m
!/matlab/README.md

!/results/
/results/*
!/results/published_matlab/
/results/published_matlab/**
!/results/published_matlab/**/
!/results/published_matlab/**/trajectory_3d.png
!/results/published_matlab/**/errors_nis.png
!/results/published_matlab/**/metrics.csv
!/results/published_matlab/README.md

# Representative q=1/q=10 MATLAB comparisons: histories and combined metrics
!/matlab/run_real_data_validation.m
!/results/published_matlab/real_data_validation/README.md
!/results/published_matlab/real_data_validation/comparison_summary.csv
!/results/published_matlab/real_data_validation/*/estimates.csv

# Final submission report
!/report/
/report/*
!/report/*.pdf

# Original MATLAB figures used by the project walkthrough
!/walkthrough_images/
/walkthrough_images/*
!/walkthrough_images/*.png
!/walkthrough_images/README.md

# Ten-flight repeated benchmark: all 1,200 metric rows and protocol
!/results/expanded_flights/
/results/expanded_flights/*
!/results/expanded_flights/trials.csv
!/results/expanded_flights/summary.json
!/results/expanded_flights/protocol.json
!/results/expanded_flights/README.md
