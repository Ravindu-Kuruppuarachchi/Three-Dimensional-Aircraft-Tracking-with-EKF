# GitHub selection: MATLAB source, published MATLAB results and active report.
# Everything else remains local. Existing tracked files are not untracked by this rule.
/*
!/.gitignore
!/README.md

!/matlab/
/matlab/*
!/matlab/*.m
!/matlab/README.md

!/results/
/results/*
!/results/published_matlab/
/results/published_matlab/**
!/results/published_matlab/**/
!/results/published_matlab/**/trajectory_3d.png
!/results/published_matlab/**/errors_nis.png
!/results/published_matlab/**/metrics.csv
!/results/published_matlab/README.md

!/report/
/report/*
!/report/main.tex
!/report/metadata.tex
!/report/README.md
!/report/University_of_Moratuwa_logo.png
!/report/figures/
/report/figures/*
!/report/figures/matlab_turn_track.png
!/report/figures/matlab_dropout_errors.png
!/report/figures/matlab_belevingsvlucht_track.png
!/report/figures/matlab_texas_track.png

!/output/
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/EN4594_EKF_Aircraft_Tracking_Report.pdf
